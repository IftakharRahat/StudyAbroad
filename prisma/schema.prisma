generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  CONTENT_MANAGER
  ADMIN
}

enum MatchCategory {
  SAFE
  TARGET
  REACH
}

enum ScholarshipStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ARCHIVED
}

enum ApplicationRiskTolerance {
  CONSERVATIVE
  BALANCED
  AMBITIOUS
  CUSTOM
}

enum DocumentStatus {
  PENDING
  PREPARED
  SUBMITTED
}

enum MonitorAlertType {
  APPLICATION_DEADLINE
  SCHOLARSHIP_DEADLINE
  REQUIREMENT_CHANGE
}

enum MonitorAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum MonitorAlertStatus {
  UNREAD
  READ
  DISMISSED
}

enum MonitoredRequirementType {
  PROGRAM
  SCHOLARSHIP
}

enum ApplicationStage {
  PLANNED
  PREPARING
  APPLIED
  INTERVIEW
  OFFER_RECEIVED
  REJECTED
  VISA_PROCESSING
  ENROLLED
}

enum RealityCheckCategory {
  HOUSING
  HIDDEN_COSTS
  PART_TIME_JOBS
  LANGUAGE_BARRIER
  STUDENT_SATISFACTION
  ACCOMMODATION
  SAFETY
  TRANSPORT
}

enum FundingGapStatus {
  SURPLUS
  BALANCED
  MINOR_GAP
  MAJOR_GAP
}

model User {
  id                   String                     @id @default(cuid())
  name                 String
  email                String                     @unique
  passwordHash         String
  role                 Role                       @default(STUDENT)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  profile              StudentProfile?
  savedScholarships    StudentSavedScholarship[]
  scholarshipDeadlines ScholarshipDeadline[]
  documentChecklistItems DocumentChecklistItem[]
  monitorAlerts        MonitorAlert[]
  applicationProgress  ApplicationProgress[]
  fundingGapAnalyses   FundingGapAnalysis[]
}

model StudentProfile {
  id                   String             @id @default(cuid())
  userId               String             @unique
  nationality          String
  currentDegree        String?
  bachelorDegreeName   String?
  universityName       String?
  departmentMajor      String?
  graduationYear       Int?
  targetDegree         String
  fieldOfStudy         String
  cgpa                 Float
  cgpaScale            Float
  ieltsScore           Float?
  toeflScore           Float?
  greScore             Int?
  gmatScore            Int?
  duolingoScore        Float?
  researchPapers       Int                @default(0)
  workExperienceMonths Int                @default(0)
  preferredCountries   String[]
  preferredIntake      String?
  researchInterest     String?
  hasWorkExperience    Boolean            @default(false)
  recentJobTitle       String?
  industryField        String?
  budgetUsd            Float
  preferredTuitionMinUsd Float?
  preferredTuitionMaxUsd Float?
  needsScholarship     Boolean            @default(true)
  careerGoal           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  readinessScores      ReadinessScore[]
  universityMatches    UniversityMatch[]
  scholarshipMatches   ScholarshipMatch[]
  applicationStrategyPlans ApplicationStrategyPlan[]
  requirementSnapshots RequirementSnapshot[]
}

model Country {
  id                         String        @id @default(cuid())
  name                       String        @unique
  averageLivingCostUsd       Float
  postStudyWorkVisaMonths    Int
  partTimeWorkHours          Int
  visaDifficulty             String
  languageRequirement        String
  safetyScore                Float
  notes                      String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  universities               University[]
  scholarships               Scholarship[]
}

model University {
  id                    String        @id @default(cuid())
  name                  String
  countryId             String
  city                  String
  rankingBand           String
  acceptanceDifficulty  Int
  websiteUrl            String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  country               Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  programs              Program[]
  scholarships          Scholarship[]
  realityChecks         UniversityRealityCheck[]

  @@unique([name, countryId])
}

model Program {
  id                       String             @id @default(cuid())
  universityId             String
  title                    String
  degreeLevel              String
  field                    String
  tuitionUsd               Float
  minCgpa                  Float
  minIelts                 Float?
  minToefl                 Float?
  minGre                   Int?
  researchPreferred        Boolean            @default(false)
  workExperiencePreferred  Boolean            @default(false)
  deadline                 DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  university               University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  scholarships             Scholarship[]
  universityMatches        UniversityMatch[]
  applicationStrategyItems ApplicationStrategyItem[]
  documentChecklistItems   DocumentChecklistItem[]
  monitorAlerts            MonitorAlert[]
  requirementSnapshots     RequirementSnapshot[]
  applicationProgress      ApplicationProgress[]
  fundingGapItems          FundingGapItem[]

  @@unique([universityId, title])
}

model DocumentChecklistItem {
  id        String         @id @default(cuid())
  userId    String
  programId String
  title     String
  category  String
  status    DocumentStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   Program        @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId, title])
  @@index([userId, status])
}

model Scholarship {
  id                    String              @id @default(cuid())
  name                  String              @unique
  countryId             String?
  universityId          String?
  programId             String?
  degreeLevel           String              @default("Master's Degree")
  eligibleNationalities String[]
  eligibleFields        String[]
  minCgpa               Float?
  minIelts              Float?
  researchRequired      Boolean             @default(false)
  amountUsd             Float?
  coverageType          String
  deadline              DateTime?
  requiredDocuments     String[]            @default([])
  status                ScholarshipStatus   @default(APPROVED)
  sourceUrl             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  country               Country?            @relation(fields: [countryId], references: [id], onDelete: SetNull)
  university            University?         @relation(fields: [universityId], references: [id], onDelete: SetNull)
  program               Program?            @relation(fields: [programId], references: [id], onDelete: SetNull)
  eligibilityRule       ScholarshipEligibilityRule?
  savedBy               StudentSavedScholarship[]
  deadlines             ScholarshipDeadline[]
  scholarshipMatches    ScholarshipMatch[]
  monitorAlerts         MonitorAlert[]
  requirementSnapshots  RequirementSnapshot[]
}

model ScholarshipEligibilityRule {
  id                    String      @id @default(cuid())
  scholarshipId         String      @unique
  degreeLevel           String
  eligibleNationalities String[]
  eligibleSubjects      String[]
  minCgpa               Float?
  minIelts              Float?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  scholarship           Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
}

model StudentSavedScholarship {
  id            String      @id @default(cuid())
  userId        String
  scholarshipId String
  notes         String?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
}

model ScholarshipDeadline {
  id            String      @id @default(cuid())
  userId        String
  scholarshipId String
  title         String
  deadline      DateTime
  status        String      @default("TRACKED")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
}

model ReadinessScore {
  id               String          @id @default(cuid())
  studentProfileId String
  tier             String
  score            Int
  strengths        Json
  weaknesses       Json
  recommendations  Json
  createdAt        DateTime        @default(now())
  studentProfile   StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model UniversityMatch {
  id               String          @id @default(cuid())
  studentProfileId String
  programId        String
  category         MatchCategory
  score            Int
  reasons          Json
  createdAt        DateTime        @default(now())
  studentProfile   StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  program          Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  applicationStrategyItems ApplicationStrategyItem[]
}

model ScholarshipMatch {
  id                 String          @id @default(cuid())
  studentProfileId   String
  scholarshipId      String
  matchingPercentage Int
  status             String          @default("NOT_RECOMMENDED")
  reasons            Json
  missingRequirements Json?
  createdAt          DateTime        @default(now())
  studentProfile     StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  scholarship        Scholarship     @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, scholarshipId])
}

model ApplicationStrategyPlan {
  id                String                    @id @default(cuid())
  studentProfileId  String
  totalApplications Int
  safeCount         Int
  targetCount       Int
  reachCount        Int
  riskTolerance     ApplicationRiskTolerance  @default(BALANCED)
  summary           String
  warnings          Json
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  studentProfile    StudentProfile            @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  items             ApplicationStrategyItem[]

  @@index([studentProfileId, createdAt])
}

model ApplicationStrategyItem {
  id          String                   @id @default(cuid())
  planId      String
  programId   String
  matchId     String?
  category    MatchCategory
  rank        Int
  score       Int
  rationale   Json
  isLocked    Boolean                  @default(false)
  createdAt   DateTime                 @default(now())
  plan        ApplicationStrategyPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  program     Program                  @relation(fields: [programId], references: [id], onDelete: Cascade)
  match       UniversityMatch?         @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([planId, category])
  @@index([programId])
  @@index([matchId])
}

model MonitorAlert {
  id             String                   @id @default(cuid())
  userId         String
  type           MonitorAlertType
  severity       MonitorAlertSeverity
  status         MonitorAlertStatus       @default(UNREAD)
  entityType     MonitoredRequirementType
  programId      String?
  scholarshipId  String?
  title          String
  message        String
  dueDate        DateTime?
  field          String?
  previousValue  String?
  currentValue   String?
  dedupeKey      String
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program        Program?                 @relation(fields: [programId], references: [id], onDelete: SetNull)
  scholarship    Scholarship?             @relation(fields: [scholarshipId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, status, createdAt])
  @@index([programId])
  @@index([scholarshipId])
}

model RequirementSnapshot {
  id                String                    @id @default(cuid())
  studentProfileId  String
  entityType        MonitoredRequirementType
  programId         String?
  scholarshipId     String?
  requirements      Json
  requirementHash   String
  lastCheckedAt     DateTime                  @updatedAt
  createdAt         DateTime                  @default(now())
  studentProfile    StudentProfile            @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  program           Program?                  @relation(fields: [programId], references: [id], onDelete: SetNull)
  scholarship       Scholarship?              @relation(fields: [scholarshipId], references: [id], onDelete: SetNull)

  @@unique([studentProfileId, entityType, programId])
  @@unique([studentProfileId, entityType, scholarshipId])
  @@index([studentProfileId, entityType])
}

// ---------------------------------------------------------------------------
// Module 2 · Feature 3 — Application Progress Tracker
// Tracks each university application from planning to enrollment.
// ---------------------------------------------------------------------------
model ApplicationProgress {
  id            String            @id @default(cuid())
  userId        String
  programId     String
  stage         ApplicationStage  @default(PLANNED)
  notes         String?
  appliedAt     DateTime?
  decisionAt    DateTime?
  events        Json              @default("[]")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  program       Program           @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([userId, stage])
}

// ---------------------------------------------------------------------------
// Module 3 · Feature 2 — University Reality Check
// Practical, on-the-ground insights official pages rarely highlight.
// Curated/verified by Content Managers, read by Students.
// ---------------------------------------------------------------------------
model UniversityRealityCheck {
  id            String                @id @default(cuid())
  universityId  String
  category      RealityCheckCategory
  headline      String
  detail        String
  severity      Int                   @default(3) // 1 (great) .. 5 (severe issue)
  monthlyCostUsd Float?
  sourceLabel   String?
  sourceUrl     String?
  isPublished   Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  university    University            @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId, category])
  @@index([isPublished])
}

// ---------------------------------------------------------------------------
// Module 4 · Feature 2 — Funding Gap Analyzer
// Compares a student's available budget against estimated total cost and
// suggests ways to close any gap.
// ---------------------------------------------------------------------------
model FundingGapAnalysis {
  id                 String            @id @default(cuid())
  userId             String
  availableBudgetUsd Float
  scholarshipUsd     Float             @default(0)
  estimatedCostUsd   Float
  gapUsd             Float
  status             FundingGapStatus
  suggestions        Json              @default("[]")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              FundingGapItem[]

  @@index([userId, createdAt])
}

model FundingGapItem {
  id                 String              @id @default(cuid())
  analysisId         String
  programId          String
  label              String
  tuitionUsd         Float
  livingCostUsd      Float
  visaFeeUsd         Float               @default(0)
  insuranceUsd       Float               @default(0)
  applicationFeeUsd  Float               @default(0)
  flightCostUsd      Float               @default(0)
  emergencyFundUsd   Float               @default(0)
  totalCostUsd       Float
  analysis           FundingGapAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  program            Program             @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([programId])
}
