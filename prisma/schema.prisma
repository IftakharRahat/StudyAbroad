generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  CONTENT_MANAGER
  ADMIN
}

enum MatchCategory {
  SAFE
  TARGET
  REACH
}

enum ScholarshipStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ARCHIVED
}

model User {
  id                   String                     @id @default(cuid())
  name                 String
  email                String                     @unique
  passwordHash         String
  role                 Role                       @default(STUDENT)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  profile              StudentProfile?
  savedScholarships    StudentSavedScholarship[]
  scholarshipDeadlines ScholarshipDeadline[]
}

model StudentProfile {
  id                   String             @id @default(cuid())
  userId               String             @unique
  nationality          String
  currentDegree        String?
  bachelorDegreeName   String?
  universityName       String?
  departmentMajor      String?
  graduationYear       Int?
  targetDegree         String
  fieldOfStudy         String
  cgpa                 Float
  cgpaScale            Float
  ieltsScore           Float?
  toeflScore           Float?
  greScore             Int?
  gmatScore            Int?
  duolingoScore        Float?
  researchPapers       Int                @default(0)
  workExperienceMonths Int                @default(0)
  preferredCountries   String[]
  preferredIntake      String?
  researchInterest     String?
  hasWorkExperience    Boolean            @default(false)
  recentJobTitle       String?
  industryField        String?
  budgetUsd            Float
  preferredTuitionMinUsd Float?
  preferredTuitionMaxUsd Float?
  needsScholarship     Boolean            @default(true)
  careerGoal           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  readinessScores      ReadinessScore[]
  universityMatches    UniversityMatch[]
  scholarshipMatches   ScholarshipMatch[]
}

model Country {
  id                         String        @id @default(cuid())
  name                       String        @unique
  averageLivingCostUsd       Float
  postStudyWorkVisaMonths    Int
  partTimeWorkHours          Int
  visaDifficulty             String
  languageRequirement        String
  safetyScore                Float
  notes                      String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  universities               University[]
  scholarships               Scholarship[]
}

model University {
  id                    String        @id @default(cuid())
  name                  String
  countryId             String
  city                  String
  rankingBand           String
  acceptanceDifficulty  Int
  websiteUrl            String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  country               Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  programs              Program[]
  scholarships          Scholarship[]

  @@unique([name, countryId])
}

model Program {
  id                       String             @id @default(cuid())
  universityId             String
  title                    String
  degreeLevel              String
  field                    String
  tuitionUsd               Float
  minCgpa                  Float
  minIelts                 Float?
  minToefl                 Float?
  minGre                   Int?
  researchPreferred        Boolean            @default(false)
  workExperiencePreferred  Boolean            @default(false)
  deadline                 DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  university               University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  scholarships             Scholarship[]
  universityMatches        UniversityMatch[]

  @@unique([universityId, title])
}

model Scholarship {
  id                    String              @id @default(cuid())
  name                  String              @unique
  countryId             String?
  universityId          String?
  programId             String?
  degreeLevel           String              @default("Master's Degree")
  eligibleNationalities String[]
  eligibleFields        String[]
  minCgpa               Float?
  minIelts              Float?
  researchRequired      Boolean             @default(false)
  amountUsd             Float?
  coverageType          String
  deadline              DateTime?
  requiredDocuments     String[]            @default([])
  status                ScholarshipStatus   @default(APPROVED)
  sourceUrl             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  country               Country?            @relation(fields: [countryId], references: [id], onDelete: SetNull)
  university            University?         @relation(fields: [universityId], references: [id], onDelete: SetNull)
  program               Program?            @relation(fields: [programId], references: [id], onDelete: SetNull)
  eligibilityRule       ScholarshipEligibilityRule?
  savedBy               StudentSavedScholarship[]
  deadlines             ScholarshipDeadline[]
  scholarshipMatches    ScholarshipMatch[]
}

model ScholarshipEligibilityRule {
  id                    String      @id @default(cuid())
  scholarshipId         String      @unique
  degreeLevel           String
  eligibleNationalities String[]
  eligibleSubjects      String[]
  minCgpa               Float?
  minIelts              Float?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  scholarship           Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
}

model StudentSavedScholarship {
  id            String      @id @default(cuid())
  userId        String
  scholarshipId String
  notes         String?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
}

model ScholarshipDeadline {
  id            String      @id @default(cuid())
  userId        String
  scholarshipId String
  title         String
  deadline      DateTime
  status        String      @default("TRACKED")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
}

model ReadinessScore {
  id               String          @id @default(cuid())
  studentProfileId String
  tier             String
  score            Int
  strengths        Json
  weaknesses       Json
  recommendations  Json
  createdAt        DateTime        @default(now())
  studentProfile   StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model UniversityMatch {
  id               String          @id @default(cuid())
  studentProfileId String
  programId        String
  category         MatchCategory
  score            Int
  reasons          Json
  createdAt        DateTime        @default(now())
  studentProfile   StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  program          Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model ScholarshipMatch {
  id                 String          @id @default(cuid())
  studentProfileId   String
  scholarshipId      String
  matchingPercentage Int
  status             String          @default("NOT_RECOMMENDED")
  reasons            Json
  missingRequirements Json?
  createdAt          DateTime        @default(now())
  studentProfile     StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  scholarship        Scholarship     @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, scholarshipId])
}
